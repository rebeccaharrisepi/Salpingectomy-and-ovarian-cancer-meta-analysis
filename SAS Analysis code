Data WA;
	set risksets2;
	where cancerstate2 = 3;

	* Years since surgery;
	if salany= 1 then do;
		salyears =  (indexdate- salany_date)/365.25;
		salany_yrs = 1;
		if salany_date < (indexdate-(5*365.25)) then salany_yrs = 2;
		if salany_date < (indexdate-(10*365.25)) then salany_yrs = 3;
		if salany_date < (indexdate-(20*365.25)) then salany_yrs = 4; 
	* Age at surgery;
		salany_age = 1;
		if (salany_date - mdy(6,30,birth_year))/365.25 >= 50 then salany_age = 2;
	end;

	salp10 = salany_yrs;
	if salany_yrs = 4 then salp10 = 3;
run;

proc logistic data=WA ;
	strata setid;
	model censor(event='1')= salany ;
run;

proc logistic data=WA ;
	class  parity(ref = first);
	strata setid;
	model censor(event='1')= salany hyst oophany tubal PID1 endo famhis parity;
run;

